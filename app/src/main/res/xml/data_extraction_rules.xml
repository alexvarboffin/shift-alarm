<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Permission counters and the direct boot snapshot are per-device state, never restored. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/permissions.preferences_pb" />
        <exclude domain="device_file" path="shift_alarm_direct_boot.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/permissions.preferences_pb" />
        <exclude domain="device_file" path="shift_alarm_direct_boot.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
